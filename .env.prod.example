# ==============================================================================
# Kuara — Variáveis de Ambiente para Deploy em VPS (docker-compose.prod.yml)
# Copie para .env.prod e substitua as senhas antes de subir:
#   cp .env.prod.example .env.prod
# Dica para gerar segredos fortes:
#   openssl rand -hex 32
# ==============================================================================

# Porta exposta do Frontend/Proxy (Nginx):
# - Use "80" para acessar direto por http://IP_DO_VPS
# - Use "127.0.0.1:8080" se houver Nginx/Caddy/Traefik no host fazendo HTTPS (443)
APP_PORT=80

# PostgreSQL (não exposto para a internet; acessível apenas na rede Docker interna)
POSTGRES_USER=kuara
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_DO_BANCO
POSTGRES_DB=kuara_db

# Backend API
JWT_SECRET=TROQUE_POR_UM_SEGREDO_JWT_ALEATORIO_LONGO
PLATFORM_FEE_PERCENTAGE=5

# Popula dados iniciais PoC de forma idempotente no boot (use "false" para desativar)
RUN_SEED_ON_BOOT=true

# (Opcional) Restringe origens permitidas no CORS (ex: https://kuara.seudominio.com.br)
# Deixe vazio para aceitar a origem atual da PoC
CORS_ORIGIN=
